GEMINI_API_KEY = your-gemini-api-key-here
GEMINI_MODEL = gemini-3.1-flash-lite
ENABLE_LLM_NARRATIVES=false

# ===========================================
# OPTIONAL: Cache Configuration
# ===========================================
CACHE_TTL_SECONDS=86400
CACHE_DIR=cache

# ===========================================
# OPTIONAL: Risk Thresholds (Tunable)
# ===========================================
SERIAL_RETURNER_THRESHOLD=0.50
HIGH_VALUE_THRESHOLD=10000.0
COD_HIGH_VALUE_THRESHOLD=5000.0
HIGH_RTO_PINCODE_THRESHOLD=0.35
HIGH_COMPLAINT_THRESHOLD=0.70
HOSTILE_SENTIMENT_THRESHOLD=-0.40
NEW_ACCOUNT_DAYS=7
HIGH_CATEGORY_RTO_THRESHOLD=0.30

# ===========================================
# OPTIONAL: Recommendation Thresholds
# ===========================================
AUTO_APPROVE_MAX_SCORE=25.0
MANUAL_REVIEW_MAX_SCORE=60.0
MIN_CONFIDENCE_FOR_AUTO=0.50

# ===========================================
# OPTIONAL: Data Paths
# ===========================================
CUSTOMERS_CSV=synthetic_data/customers.csv
ORDERS_CSV=synthetic_data/orders.csv
SIGNALS_CSV=synthetic_data/signals.csv

# ===========================================
# OPTIONAL: Development
# ===========================================
USE_MOCK_DATA=false

# ===========================================
# OPTIONAL: Gunicorn (Production)
# ===========================================
# WEB_CONCURRENCY=4
